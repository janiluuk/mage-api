#!/usr/bin/env bash
# Simple script to run tests in Docker
# Usage: ./docker-test [filter]
# Example: ./docker-test InstanceStatusApiTest

set -e

# Use docker compose (newer) or docker-compose (older)
if command -v docker &> /dev/null; then
    if docker compose version &> /dev/null 2>&1; then
        DOCKER_COMPOSE="docker compose"
    elif command -v docker-compose &> /dev/null; then
        DOCKER_COMPOSE="docker-compose"
    else
        echo "Error: docker compose not found"
        exit 1
    fi
else
    echo "Error: docker not found"
    exit 1
fi

echo "Starting test container..."
$DOCKER_COMPOSE --profile test up -d test

echo "Waiting for container to be ready..."
sleep 2

CONTAINER_NAME="mage-api-test"

# Verify SQLite is available
echo "Verifying SQLite extension..."
if docker exec "$CONTAINER_NAME" php -r "extension_loaded('pdo_sqlite') || exit(1);" 2>/dev/null; then
    echo "✓ SQLite extension is available"
else
    echo "✗ SQLite extension not found!"
    exit 1
fi

# Run tests
echo "Running tests..."
if [ $# -eq 0 ]; then
    docker exec -e APP_ENV=testing -e DB_CONNECTION=sqlite -e DB_DATABASE=:memory: -e CACHE_DRIVER=array -e QUEUE_CONNECTION=sync "$CONTAINER_NAME" php artisan test
else
    docker exec -e APP_ENV=testing -e DB_CONNECTION=sqlite -e DB_DATABASE=:memory: -e CACHE_DRIVER=array -e QUEUE_CONNECTION=sync "$CONTAINER_NAME" php artisan test --filter "$1"
fi

EXIT_CODE=$?

# Optionally stop the test container (comment out if you want to keep it running)
# $DOCKER_COMPOSE --profile test stop test

exit $EXIT_CODE


